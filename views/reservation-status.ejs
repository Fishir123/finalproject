<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white rounded-lg shadow-lg p-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-6">Check Reservation Status</h1>
        <p class="text-gray-600 mb-8">Enter your email address or reservation ID to check your booking status</p>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                <%= error %>
            </div>
        <% } %>

        <form action="/reservation/status" method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                    <input type="email" name="email" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary" placeholder="Enter your email">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Reservation ID (Optional)</label>
                    <input type="text" name="reservation_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary" placeholder="Enter reservation ID">
                </div>
            </div>
            
            <div class="text-center">
                <button type="submit" class="btn-primary text-lg px-8 py-3">
                    <i class="fas fa-search mr-2"></i>Check Status
                </button>
            </div>
        </form>

        <div class="mt-8 text-center">
            <p class="text-gray-600 mb-4">Need help? Contact our support team</p>
            <div class="space-y-2">
                <p class="text-gray-700"><i class="fas fa-phone mr-2"></i>+1 234 567 8900</p>
                <p class="text-gray-700"><i class="fas fa-envelope mr-2"></i>support@hotelin.com</p>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

