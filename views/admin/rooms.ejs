<%- include('../partials/admin-header', { title: title, user: user, currentPage: 'rooms' }) %>

<div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Manage Rooms</h1>
        <p class="text-gray-600">View and manage all hotel rooms</p>
    </div>
    
    <!-- Room Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
        <div class="bg-white p-6 rounded-lg shadow">
            <div class="flex items-center">
                <i class="fas fa-bed text-2xl text-blue-500 mr-4"></i>
                <div>
                    <p class="text-sm text-gray-600">Total Rooms</p>
                    <p class="text-2xl font-bold text-gray-900"><%= rooms.length %></p>
                </div>
            </div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow">
            <div class="flex items-center">
                <i class="fas fa-check-circle text-2xl text-green-500 mr-4"></i>
                <div>
                    <p class="text-sm text-gray-600">Available</p>
                    <p class="text-2xl font-bold text-gray-900"><%= rooms.filter(r => r.status === 'avaible').length %></p>
                </div>
            </div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow">
            <div class="flex items-center">
                <i class="fas fa-times-circle text-2xl text-red-500 mr-4"></i>
                <div>
                    <p class="text-sm text-gray-600">Booked</p>
                    <p class="text-2xl font-bold text-gray-900"><%= rooms.filter(r => r.status === 'booked').length %></p>
                </div>
            </div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow">
            <div class="flex items-center">
                <i class="fas fa-tools text-2xl text-yellow-500 mr-4"></i>
                <div>
                    <p class="text-sm text-gray-600">Maintenance</p>
                    <p class="text-2xl font-bold text-gray-900"><%= rooms.filter(r => r.status === 'maintenance').length %></p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Filters -->
    <div class="bg-white shadow rounded-lg p-6 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Room Type</label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                    <option value="">All Types</option>
                    <% roomTypes.forEach(type => { %>
                        <option value="<%= type.id %>"><%= type.type_name %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                    <option value="">All Status</option>
                    <option value="avaible">Available</option>
                    <option value="booked">Booked</option>
                    <option value="maintenance">Maintenance</option>
                </select>
            </div>
            <div class="flex items-end">
                <button class="w-full btn-primary">
                    <i class="fas fa-search mr-2"></i>Filter
                </button>
            </div>
        </div>
    </div>
    
    <!-- Rooms Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% rooms.forEach(room => { %>
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div class="h-48 bg-gray-300 relative">
                    <% if (room.img) { %>
                        <img src="/images/<%= room.img %>" alt="<%= room.type_name %>" class="w-full h-full object-cover">
                    <% } else { %>
                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-400 to-purple-500">
                            <i class="fas fa-bed text-4xl text-white"></i>
                        </div>
                    <% } %>
                    <div class="absolute top-4 right-4">
                        <span class="px-2 py-1 rounded-full text-xs font-semibold
                            <%= room.status === 'avaible' ? 'bg-green-500 text-white' : 
                                room.status === 'booked' ? 'bg-red-500 text-white' : 
                                'bg-yellow-500 text-white' %>">
                            <%= room.status === 'avaible' ? 'Available' : 
                                room.status === 'booked' ? 'Booked' : 'Maintenance' %>
                        </span>
                    </div>
                </div>
                
                <div class="p-6">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="text-lg font-semibold text-gray-800">Room <%= room.room_number %></h3>
                        <span class="text-lg font-bold text-primary">$<%= room.price %>/night</span>
                    </div>
                    <p class="text-gray-600 mb-2"><%= room.type_name %></p>
                    <p class="text-gray-600 text-sm mb-4"><%= room.description %></p>
                    
                    <!-- Room Actions -->
                    <div class="space-y-2">
                        <% if (room.status === 'avaible') { %>
                            <form action="/admin/rooms/<%= room.id %>/status" method="POST" class="inline-block w-full">
                                <input type="hidden" name="status" value="maintenance">
                                <button type="submit" class="w-full btn-secondary text-sm">
                                    <i class="fas fa-tools mr-2"></i>Set Maintenance
                                </button>
                            </form>
                        <% } else if (room.status === 'maintenance') { %>
                            <form action="/admin/rooms/<%= room.id %>/status" method="POST" class="inline-block w-full">
                                <input type="hidden" name="status" value="avaible">
                                <button type="submit" class="w-full btn-success text-sm">
                                    <i class="fas fa-check mr-2"></i>Set Available
                                </button>
                            </form>
                        <% } else { %>
                            <button class="w-full btn-secondary opacity-50 cursor-not-allowed text-sm" disabled>
                                <i class="fas fa-lock mr-2"></i>Currently Booked
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
    
    <% if (rooms.length === 0) { %>
        <div class="text-center py-12">
            <i class="fas fa-bed text-4xl text-gray-300 mb-4"></i>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No rooms found</h3>
            <p class="text-gray-500">There are no rooms to display.</p>
        </div>
    <% } %>
</div>

<%- include('../partials/admin-footer') %>

