<%- include('partials/header') %>

<!-- Hero Section -->
<section class="hero-bg text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Welcome to HotelIn</h1>
        <p class="text-xl md:text-2xl mb-8 opacity-90">Experience luxury and comfort in the heart of the city</p>
        <a href="/rooms" class="bg-white text-primary px-8 py-3 rounded-lg text-lg font-semibold hover:bg-gray-100 transition duration-300 inline-block">
            Book Your Stay
        </a>
    </div>
</section>

<!-- Search Section -->
<section class="bg-white py-12 -mt-10 relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-lg shadow-xl p-6">
            <form action="/rooms" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Check-in Date</label>
                    <input type="date" name="check_in" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Check-out Date</label>
                    <input type="date" name="check_out" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Room Type</label>
                    <select name="room_type" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                        <option value="">All Types</option>
                        <% roomTypes.forEach(type => { %>
                            <option value="<%= type.id %>"><%= type.type_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="flex items-end">
                    <button type="submit" class="w-full btn-primary">
                        <i class="fas fa-search mr-2"></i>Search Rooms
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Featured Rooms -->
<section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-4xl font-bold text-gray-800 mb-4">Featured Rooms</h2>
            <p class="text-xl text-gray-600">Discover our most popular accommodations</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% rooms.forEach(room => { %>
                <div class="bg-white rounded-lg shadow-lg overflow-hidden card-hover">
                    <div class="h-48 bg-gray-300 relative">
                        <% if (room.img) { %>
                            <img src="/images/<%= room.img %>" alt="<%= room.type_name %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-400 to-purple-500">
                                <i class="fas fa-bed text-4xl text-white"></i>
                            </div>
                        <% } %>
                        <div class="absolute top-4 right-4">
                            <span class="bg-<%= room.status === 'avaible' ? 'green' : room.status === 'booked' ? 'red' : 'yellow' %>-500 text-white px-2 py-1 rounded-full text-xs font-semibold">
                                <%= room.status === 'avaible' ? 'Available' : room.status === 'booked' ? 'Booked' : 'Maintenance' %>
                            </span>
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-xl font-semibold text-gray-800 mb-2"><%= room.type_name %></h3>
                        <p class="text-gray-600 mb-2">Room <%= room.room_number %></p>
                        <p class="text-gray-600 mb-4 text-sm"><%= room.description %></p>
                        <div class="flex justify-between items-center">
                            <span class="text-2xl font-bold text-primary">$<%= room.price %>/night</span>
                            <% if (room.status === 'avaible') { %>
                                <a href="/reservation/book/<%= room.id %>" class="btn-primary">Book Now</a>
                            <% } else { %>
                                <button class="btn-secondary opacity-50 cursor-not-allowed" disabled>Not Available</button>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
        
        <div class="text-center mt-12">
            <a href="/rooms" class="btn-primary text-lg px-8 py-3">View All Rooms</a>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="bg-gray-100 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-4xl font-bold text-gray-800 mb-4">Why Choose HotelIn?</h2>
            <p class="text-xl text-gray-600">Experience the best hospitality services</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
                <div class="bg-primary text-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-wifi text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">Free WiFi</h3>
                <p class="text-gray-600">High-speed internet access throughout the hotel</p>
            </div>
            
            <div class="text-center">
                <div class="bg-primary text-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-concierge-bell text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">24/7 Service</h3>
                <p class="text-gray-600">Round-the-clock room service and assistance</p>
            </div>
            
            <div class="text-center">
                <div class="bg-primary text-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-swimming-pool text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">Pool & Spa</h3>
                <p class="text-gray-600">Relax and unwind in our premium facilities</p>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>

