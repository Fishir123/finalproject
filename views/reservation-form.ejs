<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <!-- Room Image -->
        <div class="h-64 md:h-80">
            <% if (room.img) { %>
                <img src="/images/<%= room.img %>" alt="<%= room.type_name %>" class="w-full h-full object-cover">
            <% } else { %>
                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-400 to-purple-500">
                    <i class="fas fa-bed text-6xl text-white"></i>
                </div>
            <% } %>
        </div>

        <div class="p-8">
            <!-- Room Info -->
            <div class="mb-8">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800 mb-2"><%= room.type_name %></h1>
                        <p class="text-xl text-gray-600">Room <%= room.room_number %></p>
                    </div>
                    <div class="text-right">
                        <span class="text-3xl font-bold text-primary">$<%= room.price %></span>
                        <span class="text-gray-600">/night</span>
                    </div>
                </div>
                
                <p class="text-gray-700 mb-6"><%= room.description %></p>
                
                <!-- Room Features -->
                <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-8">
                    <div class="flex items-center">
                        <i class="fas fa-wifi text-primary mr-3"></i>
                        <span>Free WiFi</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-tv text-primary mr-3"></i>
                        <span>Flat Screen TV</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-snowflake text-primary mr-3"></i>
                        <span>Air Conditioning</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-bath text-primary mr-3"></i>
                        <span>Private Bathroom</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-concierge-bell text-primary mr-3"></i>
                        <span>Room Service</span>
                    </div>
                    <div class="flex items-center">
                        <i class="fas fa-coffee text-primary mr-3"></i>
                        <span>Coffee Maker</span>
                    </div>
                </div>
            </div>

            <!-- Booking Form -->
            <div class="border-t pt-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Book This Room</h2>
                
                <% if (room.status !== 'avaible') { %>
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                        <strong>Sorry!</strong> This room is currently not available for booking.
                    </div>
                <% } else { %>
                    <form action="/reservation/book" method="POST" class="space-y-6">
                        <input type="hidden" name="room_id" value="<%= room.id %>">
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Check-in Date</label>
                                <input type="date" name="check_in" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Check-out Date</label>
                                <input type="date" name="check_out" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
                                <input type="text" name="guest_name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                                <input type="email" name="guest_email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                                <input type="tel" name="guest_phone" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Payment Method</label>
                                <select name="payment_method" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                                    <option value="">Select Payment Method</option>
                                    <option value="cash">Cash</option>
                                    <option value="card">Credit Card</option>
                                    <option value="transfer">Bank Transfer</option>
                                </select>
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Address</label>
                            <textarea name="guest_address" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary"></textarea>
                        </div>
                        
                        <div class="flex justify-between items-center pt-6">
                            <a href="/rooms" class="btn-secondary">Back to Rooms</a>
                            <button type="submit" class="btn-primary text-lg px-8 py-3">
                                <i class="fas fa-credit-card mr-2"></i>Book Now
                            </button>
                        </div>
                    </form>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

