<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Page Header -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-800 mb-4">Available Rooms</h1>
        <p class="text-xl text-gray-600">Find the perfect room for your stay</p>
    </div>

    <!-- Search Filters -->
    <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
        <form action="/rooms" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Check-in Date</label>
                <input type="date" name="check_in" value="<%= filters.check_in || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Check-out Date</label>
                <input type="date" name="check_out" value="<%= filters.check_out || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Room Type</label>
                <select name="room_type" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-primary focus:border-primary">
                    <option value="">All Types</option>
                    <% roomTypes.forEach(type => { %>
                        <option value="<%= type.id %>" <%= filters.room_type == type.id ? 'selected' : '' %>><%= type.type_name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="flex items-end">
                <button type="submit" class="w-full btn-primary">
                    <i class="fas fa-search mr-2"></i>Search
                </button>
            </div>
        </form>
    </div>

    <!-- Results -->
    <div class="mb-6">
        <p class="text-gray-600">Found <%= rooms.length %> room(s)</p>
    </div>

    <!-- Rooms Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <% rooms.forEach(room => { %>
            <div class="bg-white rounded-lg shadow-lg overflow-hidden card-hover">
                <div class="md:flex">
                    <div class="md:w-1/2 h-64 md:h-auto">
                        <% if (room.img) { %>
                            <img src="/images/<%= room.img %>" alt="<%= room.type_name %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-400 to-purple-500">
                                <i class="fas fa-bed text-4xl text-white"></i>
                            </div>
                        <% } %>
                    </div>
                    <div class="md:w-1/2 p-6">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-xl font-semibold text-gray-800"><%= room.type_name %></h3>
                            <span class="bg-<%= room.status === 'avaible' ? 'green' : room.status === 'booked' ? 'red' : 'yellow' %>-500 text-white px-2 py-1 rounded-full text-xs font-semibold">
                                <%= room.status === 'avaible' ? 'Available' : room.status === 'booked' ? 'Booked' : 'Maintenance' %>
                            </span>
                        </div>
                        <p class="text-gray-600 mb-2">Room <%= room.room_number %></p>
                        <p class="text-gray-600 mb-4 text-sm"><%= room.description %></p>
                        
                        <div class="space-y-2 mb-4">
                            <div class="flex items-center text-sm text-gray-600">
                                <i class="fas fa-wifi mr-2"></i>Free WiFi
                            </div>
                            <div class="flex items-center text-sm text-gray-600">
                                <i class="fas fa-tv mr-2"></i>Flat Screen TV
                            </div>
                            <div class="flex items-center text-sm text-gray-600">
                                <i class="fas fa-snowflake mr-2"></i>Air Conditioning
                            </div>
                        </div>
                        
                        <div class="flex justify-between items-center">
                            <div>
                                <span class="text-2xl font-bold text-primary">$<%= room.price %></span>
                                <span class="text-gray-600">/night</span>
                            </div>
                            <% if (room.status === 'avaible') { %>
                                <a href="/reservation/book/<%= room.id %>" class="btn-primary">Book Now</a>
                            <% } else { %>
                                <button class="btn-secondary opacity-50 cursor-not-allowed" disabled>Not Available</button>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <% if (rooms.length === 0) { %>
        <div class="text-center py-12">
            <i class="fas fa-bed text-6xl text-gray-300 mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-600 mb-2">No rooms found</h3>
            <p class="text-gray-500">Try adjusting your search criteria</p>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>

