<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#3B82F6',
                        secondary: '#1E40AF',
                        accent: '#F59E0B'
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="bg-gray-800 text-white w-64 space-y-6 py-7 px-2 absolute inset-y-0 left-0 transform -translate-x-full md:relative md:translate-x-0 transition duration-200 ease-in-out" id="sidebar">
            <!-- Logo -->
            <div class="text-center">
                <div class="flex items-center justify-center space-x-2">
                    <i class="fas fa-hotel text-2xl text-primary"></i>
                    <span class="text-2xl font-bold">HotelIn</span>
                </div>
                <p class="text-sm text-gray-300 mt-1">Admin Panel</p>
            </div>
            
            <!-- Navigation -->
            <nav class="space-y-2">
                <a href="/admin/dashboard" class="<%= currentPage === 'dashboard' ? 'bg-primary text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white' %> block py-2.5 px-4 rounded transition duration-200">
                    <i class="fas fa-tachometer-alt mr-3"></i>Dashboard
                </a>
                <a href="/admin/reservations" class="<%= currentPage === 'reservations' ? 'bg-primary text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white' %> block py-2.5 px-4 rounded transition duration-200">
                    <i class="fas fa-calendar-check mr-3"></i>Reservations
                </a>
                <a href="/admin/rooms" class="<%= currentPage === 'rooms' ? 'bg-primary text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white' %> block py-2.5 px-4 rounded transition duration-200">
                    <i class="fas fa-bed mr-3"></i>Rooms
                </a>
                <a href="/admin/guests" class="<%= currentPage === 'guests' ? 'bg-primary text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white' %> block py-2.5 px-4 rounded transition duration-200">
                    <i class="fas fa-users mr-3"></i>Guests
                </a>
                <a href="/admin/payments" class="<%= currentPage === 'payments' ? 'bg-primary text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white' %> block py-2.5 px-4 rounded transition duration-200">
                    <i class="fas fa-credit-card mr-3"></i>Payments
                </a>
            </nav>
            
            <!-- User Info -->
            <div class="absolute bottom-0 w-full p-4">
                <div class="bg-gray-700 rounded-lg p-3">
                    <p class="text-sm font-medium"><%= user.username %></p>
                    <p class="text-xs text-gray-300">Administrator</p>
                    <a href="/admin/logout" class="text-red-400 hover:text-red-300 text-sm mt-2 inline-block">
                        <i class="fas fa-sign-out-alt mr-1"></i>Logout
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Main Content -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Top bar -->
            <header class="bg-white shadow-lg">
                <div class="max-w-7xl mx-auto py-4 px-4 sm:px-6 lg:px-8">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center">
                            <button class="md:hidden text-gray-500 hover:text-gray-700" id="sidebar-toggle">
                                <i class="fas fa-bars text-xl"></i>
                            </button>
                            <h1 class="text-2xl font-bold text-gray-900 ml-4 md:ml-0">
                                <%= currentPage.charAt(0).toUpperCase() + currentPage.slice(1) %>
                            </h1>
                        </div>
                        <div class="flex items-center space-x-4">
                            <a href="/" target="_blank" class="text-gray-500 hover:text-gray-700">
                                <i class="fas fa-external-link-alt"></i>
                                <span class="ml-1 hidden sm:inline">View Website</span>
                            </a>
                        </div>
                    </div>
                </div>
            </header>
            
            <!-- Page Content -->
            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-100">

